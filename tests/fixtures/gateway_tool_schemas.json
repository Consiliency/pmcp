 "gateway.invoke": {
  "properties": {
   "_meta": {
    "additionalProperties": true,
    "description": "Request metadata; trace context keys are forwarded downstream",
    "type": [
     "object",
     "null"
    ]
   },
   "arguments": {
    "additionalProperties": true,
    "description": "Arguments to pass to the tool (must match tool schema)",
    "type": "object"
   },
   "evidence_label_digest": {
    "description": "SHA-256 digest of the caller evidence label",
    "pattern": "^[0-9a-f]{64}$",
    "type": [
     "string",
     "null"
    ]
   },
   "options": {
    "description": "Timeout, output truncation, and redaction options",
    "properties": {
     "max_output_chars": {
      "description": "Maximum output characters (truncated if exceeded)",
      "maximum": 100000,
      "minimum": 100,
      "type": [
       "integer",
       "null"
      ]
     },
     "redact_secrets": {
      "default": false,
      "description": "Redact detected secrets from output",
      "type": "boolean"
     },
     "timeout_ms": {
      "default": 30000,
      "description": "Timeout in milliseconds",
      "maximum": 300000,
      "minimum": 1000,
      "type": "integer"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "run_correlation_id": {
    "description": "Scoped-advisor run correlation ID",
    "maxLength": 128,
    "minLength": 1,
    "type": [
     "string",
     "null"
    ]
   },
   "seat_correlation_id": {
    "description": "Scoped-advisor seat correlation ID",
    "maxLength": 128,
    "minLength": 1,
    "type": [
     "string",
     "null"
    ]
   },
   "task": {
    "description": "Run as an MCP task (long-running invocation)",
    "properties": {
     "enabled": {
      "default": true,
      "description": "Run as an MCP task when the server supports it",
      "type": "boolean"
     },
     "metadata": {
      "additionalProperties": true,
      "description": "Opaque task metadata forwarded downstream",
      "type": [
       "object",
       "null"
      ]
     },
     "poll_interval": {
      "description": "Seconds between task status polls",
      "type": [
       "number",
       "null"
      ]
     },
     "requestor_context": {
      "additionalProperties": true,
      "description": "Opaque requestor context forwarded downstream",
      "type": [
       "object",
       "null"
      ]
     },
     "ttl": {
      "description": "Requested task TTL in seconds",
      "type": [
       "integer",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "tool_id": {
    "description": "The tool ID in format \"server_name::tool_name\"",
    "minLength": 1,
    "type": "string"
   },
   "trace_context": {
    "description": "Trace context forwarded to the downstream server",
    "properties": {
     "baggage": {
      "description": "W3C baggage header value",
      "type": [
       "string",
       "null"
      ]
     },
     "traceparent": {
      "description": "W3C traceparent header value",
      "type": [
       "string",
       "null"
      ]
     },
     "tracestate": {
      "description": "W3C tracestate header value",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   }
  },
  "required": [
   "tool_id"
  ],
  "type": "object"
 },
